{
  "schema_version": 1,
  "sources": [
    {
      "id": "verified-json-inbox",
      "type": "json_directory",
      "path": "data/inbox",
      "enabled": true
    },
    {
      "id": "public-json-example",
      "type": "json_url",
      "url": "https://example.org/wechat-hot-radar.json",
      "enabled": false
    },
